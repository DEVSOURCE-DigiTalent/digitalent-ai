// DBML TableGroups organize the canvas; they do not create extra SQL tables.
TableGroup Identity_Access {
  users
  roles
  permissions
  user_roles
  role_permissions
  refresh_tokens
}

TableGroup Organization_Jobs {
  organizations
  departments
  job_families
  job_positions
  employees
}

TableGroup Competency_Requirements {
  competency_frameworks
  competency_categories
  competencies
  competency_framework_mappings
  competency_level_criteria
  position_requirement_sets
  position_requirement_items
  employee_competency_profiles
  competency_evidences
}

TableGroup Learning {
  courses
  course_competencies
  course_prerequisites
  course_learning_outcomes
  course_modules
  lessons
  lesson_learning_outcomes
  learning_materials
  course_assignments
  enrollments
  lesson_progress
}

TableGroup Assessment {
  question_banks
  questions
  question_options
  assessments
  assessment_questions
  assessment_attempts
  assessment_answers
}

TableGroup Certificates {
  certificate_templates
  certificates
  certificate_verification_logs
}

TableGroup Practical_Tasks {
  practical_task_templates
  practical_task_targets
  task_assignments
  assigned_task_targets
  task_submissions
  task_submission_files
  task_evaluations
  competency_evaluation_results
}

TableGroup Skill_Gap {
  skill_gap_runs
  skill_gap_items
}

TableGroup Shared_Infra {
  file_objects
  notifications
  audit_logs
  system_settings
}

TableGroup Intelligence_Extension {
  scoring_configs
  scoring_config_items
  training_risk_scores
  readiness_scores
}

