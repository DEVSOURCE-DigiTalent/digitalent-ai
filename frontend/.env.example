# DigiTalent AI — Frontend Environment Configuration
# Copy this file to .env and adjust values for your environment
#   cp .env.example .env

# ── API ──
# Backend API base URL (ASP.NET Core)
VITE_API_BASE_URL=http://localhost:5000/api/v1
# SignalR hub URL for real-time notifications
VITE_SIGNALR_HUB_URL=http://localhost:5000/hubs/notifications

# ── Application ──
VITE_APP_NAME=DigiTalent AI
VITE_APP_VERSION=1.0.0

# ── Feature Flags ──
# Enable AI-powered draft suggestions (question generation, task suggestions)
VITE_AI_ENABLED=false
# Enable career/promotion readiness analysis (optional bonus feature)
VITE_CAREER_READINESS_ENABLED=false

# ── UI Defaults ──
VITE_DEFAULT_THEME=light
VITE_SIDEBAR_DEFAULT_COLLAPSED=false
VITE_PAGE_SIZE_DEFAULT=20
