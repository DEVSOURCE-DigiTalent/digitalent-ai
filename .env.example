# Database
POSTGRES_DB=digitalent
POSTGRES_USER=digitalent_app
POSTGRES_PASSWORD=          # REQUIRED: Set a strong password

# AI assistant chatbot: ASSISTANT_PROVIDER = Claude | Gemini. Empty key = chatbot answers ASSISTANT_NOT_CONFIGURED.
ASSISTANT_PROVIDER=Gemini
ASSISTANT_API_KEY=          # Gemini key (AI Studio) hoặc Anthropic key; KHÔNG commit

# JWT
JWT_ISSUER=DigiTalentAI
JWT_AUDIENCE=DigiTalentAI.Web
JWT_SIGNING_KEY=            # REQUIRED: Generate a secure 64+ char key

# MinIO
MINIO_ACCESS_KEY=digitalent_minio
MINIO_SECRET_KEY=           # REQUIRED: Set a strong password

# App
ASPNETCORE_ENVIRONMENT=Production
ALLOWED_ORIGINS=http://localhost:80
